{
  "name": "nahida",
  "version": "0.1.0",
  "description": "A terminal agent for writing, reading and science work, built on pi-ai and pi-agent-core",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "nahida": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
